                                                "format": "date-time"
                                            }
                                        },
                                        "required": [
                                            "id",
                                            "name",
                                            "status",
                                            "failure_threshold",
                                            "failure_count",
                                            "created_at",
                                            "updated_at"
                                        ],
                                        "additionalProperties": false
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
