{
    "name": "agents",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc -b",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run && pnpm --filter @agents/web test",
        "dev": "pnpm --filter @agents/control-plane --filter @agents/worker --filter @agents/web --parallel dev",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@bufbuild/buf",
            "esbuild",
            "protobufjs",
            "unrs-resolver"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^9.20.0",
        "@types/node": "^22.12.0",
        "eslint": "^9.20.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-import-x": "^4.6.0",
        "prettier": "^3.5.0",
        "tsx": "^4.19.0",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.23.0",
        "vitest": "^3.0.0"
    }
}
